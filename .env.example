# Copy this file to .env and adjust the paths for this machine.
# .env is gitignored; .env.example is committed as the template.
# Shell environment variables take precedence over anything set here.

# Path to the experimental_database plasma_discharges.json descriptor (read-only).
FUSION_DISCHARGE_DB=/hdd1/experimental_database/plasma_discharges.json

# Root folder holding the raw / preprocessed shot data, one subfolder per diagnostic.
FUSION_DATA_FOLDER=/hdd1/fusion_data/

# Where Shot Explorer keeps its own state: the SQLite database and the
# cached netCDF analysis results. Must be writable by the service user.
FUSION_UI_DB=/hdd1/fusion_ui/shot_explorer.sqlite
FUSION_UI_CACHE=/hdd1/fusion_ui/cache
